{
  "name": "@m2k-5f/pgtx",
  "version": "2.8.0",
  "type": "module",
  "description": "Blazing-fast PostgreSQL driver with pipeline support.",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "testGitHub": "node --import tsx --test $(find tests -name '*.test.ts')",
    "test": "node --env-file=.env --import tsx --test ./tests/*.test.ts",
    "benchmark": "npx tsx benchmark.ts"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/M2Kc-s4/pgtx.git"
  },
  "keywords": [
    "sql",
    "postgres",
    "blazing",
    "stream",
    "driver",
    "pipeline",
    "query-builder",
    "typescript",
    "transactions",
    "prepared-statements"
  ],
  "author": "M2Kc-s4",
  "license": "MIT",
  "homepage": "https://github.com/M2Kc-s4/pgtx",
  "bugs": {
    "url": "https://github.com/M2Kc-s4/pgtx/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "mitata": "^1.0.34",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fluent-future": "^1.5.0"
  }
}
